# Base de données PostgreSQL (avec extension PostGIS activée)
# DATABASE_URL = connexion "pooled" (utilisée par l'application au quotidien)
# DIRECT_URL   = connexion directe (utilisée uniquement par Prisma pour les migrations)
DATABASE_URL="postgresql://user:password@localhost:5432/coride"
DIRECT_URL="postgresql://user:password@localhost:5432/coride"

# Authentification
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN="7d"

# Stripe (paiement par carte)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudinary (stockage des photos et documents de vérification)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Serveur
PORT=4000
